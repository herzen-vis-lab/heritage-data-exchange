{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/herzen-vis-lab/heritage-data-exchange/main/schema/federated-exchange-document.schema.json",
  "title": "FederatedExchangeDocument",
  "description": "Federated exchange of digital cultural heritage objects in a loosely coupled network. Data model v0.0.8.",
  "$ref": "#/$defs/FederatedExchangeDocument",
  "$defs": {
    "FederatedExchangeDocument": {
      "title": "FederatedExchangeDocument",
      "type": "object",
      "properties": {
        "federated_exchange_document_guid": {
          "type": "string",
          "format": "uuid",
          "description": "Globally unique (UUID v4), immutable, lowercase"
        },
        "standard": {
          "type": "string",
          "format": "uri",
          "description": "Identifier of the exchange standard (protocol namespace)"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version (MAJOR.MINOR.PATCH) of the exchange document"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        },
        "federationnode": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FederationNode"
          },
          "description": "Nodes (organizations) participating in the federation snapshot"
        }
      },
      "required": [
        "federated_exchange_document_guid",
        "standard",
        "version",
        "generated_at"
      ],
      "additionalProperties": false
    },
    "FederationNode": {
      "title": "FederationNode",
      "type": "object",
      "properties": {
        "federation_node_guid": {
          "type": "string",
          "format": "uuid",
          "description": "Globally unique (UUID v4), immutable, lowercase. Identifies the organization-node without a central operator"
        },
        "federation_node_url": {
          "type": "string",
          "format": "uri",
          "description": "Base URL of the node service (exchange endpoint)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        },
        "modified_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        },
        "digitalobject": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DigitalObject"
          }
        },
        "person": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Person"
          }
        },
        "metadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Metadata"
          }
        },
        "classification": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Classification"
          }
        },
        "relation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          }
        },
        "license": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/License"
          },
          "description": "Licenses applied by default to objects published by this node"
        }
      },
      "required": [
        "federation_node_guid",
        "federation_node_url",
        "created_at",
        "modified_at"
      ],
      "additionalProperties": false
    },
    "DigitalObject": {
      "title": "DigitalObject",
      "type": "object",
      "properties": {
        "digital_object_guid": {
          "type": "string",
          "format": "uuid",
          "description": "Globally unique (UUID v4), immutable, lowercase. Assigned by the source organization"
        },
        "digital_object_media_url": {
          "type": "string",
          "format": "uri",
          "description": "URL of the digital representation (media) of the object"
        },
        "local_identifier": {
          "type": "string",
          "description": "Local identifier of the object in the source organization, e.g. AK1"
        },
        "record_url": {
          "type": "string",
          "format": "uri",
          "description": "Canonical URL of the object record in the source organization's service"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        },
        "modified_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        },
        "metadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Metadata"
          }
        },
        "classification": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Classification"
          }
        },
        "license": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/License"
          },
          "description": "Licenses of the digital object (like classification — code + authority)"
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "DigitalObject",
            "Work",
            "Manifestation",
            "Item"
          ],
          "default": "DigitalObject",
          "description": "Entity type: Work — abstract entity (the first registrar is the primary source of attributes); Manifestation — a realization of a Work; Item — a physical/local copy owned by a node"
        },
        "work_guid": {
          "type": "string",
          "format": "uuid",
          "description": "Reference to the abstract Work entity (for Manifestation and Item)"
        },
        "manifestation_guid": {
          "type": "string",
          "format": "uuid",
          "description": "Reference to the Manifestation (for Item)"
        },
        "owner_node_guid": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of the node owning the Item (for Item)"
        },
        "rights_holder_confirmation": {
          "type": "object",
          "description": "Явное подтверждение правообладателя при регистрации работ, созданных третьими лицами (например, студенческих): исключает регистрацию чужой работы без ведома автора",
          "properties": {
            "confirmed": {
              "type": "boolean",
              "const": true
            },
            "confirmed_by_person_guid": {
              "type": "string",
              "format": "uuid",
              "description": "Правообладатель (например, студент), подтвердивший регистрацию"
            },
            "confirmed_at": {
              "type": "string",
              "format": "date-time"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "confirmed",
            "confirmed_by_person_guid",
            "confirmed_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "digital_object_guid",
        "digital_object_media_url",
        "created_at",
        "modified_at"
      ],
      "additionalProperties": false
    },
    "Classification": {
      "title": "Classification",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Classifier code, e.g. group identifier of the universal classifier"
        },
        "authority": {
          "type": "string",
          "format": "uri",
          "description": "URI of the authoritative vocabulary (AAT, ULAN, LCSH, VIAF or a federation-registered classifier)"
        },
        "source_node_guid": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of the node that asserted this classification (provenance)"
        },
        "asserted_by_person_guid": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of the expert (Person) who performed the attribution. Scoped by source_node_guid (the node that asserted the classification)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        },
        "modified_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        }
      },
      "required": [
        "code",
        "authority"
      ],
      "additionalProperties": false
    },
    "Metadata": {
      "title": "Metadata",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Metadata attribute key, e.g. title, description, material"
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "description": "JSON scalar: string, number, or boolean"
        },
        "language": {
          "type": "string",
          "description": "BCP 47 language tag, e.g. ru, en"
        },
        "authority": {
          "type": "string",
          "format": "uri",
          "description": "URI of the authoritative source defining the semantics of the attribute"
        },
        "source_node_guid": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of the node that asserted this attribute (provenance; enables conflict resolution during enrichment)"
        },
        "asserted_by_person_guid": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of the expert (Person) who asserted/attributed this attribute. Scoped by the attribute's source_node_guid: the person belongs to the same node"
        },
        "attribution_status": {
          "$ref": "#/$defs/AttributionStatus",
          "description": "Verification level of the attribute: unverified, expert_verified, authoritative"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        },
        "modified_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        },
        "is_enabled_for_ai_using": {
          "type": "boolean",
          "description": "Allows using the attribute value in AI training data. Absent means not allowed (conservative default)"
        },
        "status": {
          "enum": [
            "unresolved",
            "canonical",
            "rejected"
          ],
          "description": "Статус атрибута: unresolved — заявления расходятся и конфликт не разрешён; canonical — достигнуто N≥2 независимых подтверждений или дефолт по fallback; rejected — отклонено"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "description": "Конкурирующие заявления по этому атрибуту; значение самого атрибута (value) — одно из заявлений, остальные — в claims"
        }
      },
      "required": [
        "key",
        "value",
        "language",
        "authority"
      ],
      "additionalProperties": false
    },
    "Person": {
      "title": "Person",
      "description": "Expert (attributor/verifier) registered at a node. Identity is node-scoped: person_guid is unique within the owner node; full identity is the pair (federation_node_guid, person_guid). There is no global person registry — consistent with the no-central-operator principle",
      "type": "object",
      "properties": {
        "person_guid": {
          "type": "string",
          "format": "uuid",
          "description": "Globally unique (UUID v4), immutable, lowercase"
        },
        "full_name": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "description": "BCP 47 language tag of the name"
        },
        "metadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Metadata"
          }
        },
        "classification": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Classification"
          }
        }
      },
      "required": [
        "person_guid",
        "full_name",
        "language"
      ],
      "additionalProperties": false
    },
    "Relation": {
      "title": "Relation",
      "type": "object",
      "properties": {
        "relation_guid": {
          "type": "string",
          "format": "uuid",
          "description": "Globally unique (UUID v4), immutable, lowercase"
        },
        "source_type": {
          "$ref": "#/$defs/NodeType"
        },
        "source_guid": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of the source node (FederationNode, DigitalObject or Person)"
        },
        "target_type": {
          "$ref": "#/$defs/NodeType"
        },
        "target_guid": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of the target node (FederationNode, DigitalObject or Person)"
        },
        "relation": {
          "type": "string",
          "description": "Relation type, e.g. same_as, duplicate_of"
        },
        "authority": {
          "type": "string",
          "format": "uri",
          "description": "URI of the authoritative source defining the semantics of the relation type"
        },
        "status": {
          "$ref": "#/$defs/StatusType",
          "description": "Record linkage status: candidate_match, confirmed_match or rejected_match"
        },
        "asserted_by_node_guid": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of the node that asserted the relation (provenance)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        }
      },
      "required": [
        "relation_guid",
        "source_type",
        "source_guid",
        "target_type",
        "target_guid",
        "relation",
        "authority",
        "status",
        "asserted_by_node_guid",
        "created_at"
      ],
      "additionalProperties": false
    },
    "NodeType": {
      "title": "NodeType",
      "enum": [
        "FederationNode",
        "DigitalObject",
        "Person",
        "Work",
        "Manifestation",
        "Item"
      ]
    },
    "StatusType": {
      "title": "StatusType",
      "enum": [
        "candidate_match",
        "confirmed_match",
        "rejected_match"
      ]
    },
    "AttributionStatus": {
      "title": "AttributionStatus",
      "enum": [
        "unverified",
        "expert_verified",
        "authoritative"
      ]
    },
    "License": {
      "title": "License",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "License code, e.g. CC-BY-4.0 (SPDX identifier)"
        },
        "authority": {
          "type": "string",
          "format": "uri",
          "description": "URI of the authoritative source of the license (SPDX, Creative Commons, a registry of an organization, or a non-profit organization (NGO) as one possible variant)"
        },
        "source_node_guid": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of the node that asserted this license (provenance)"
        },
        "asserted_by_person_guid": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of the expert (Person) who asserted the license. Scoped by source_node_guid"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        },
        "modified_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp"
        }
      },
      "required": [
        "code",
        "authority"
      ],
      "additionalProperties": false
    },
    "Claim": {
      "title": "Claim",
      "type": "object",
      "description": "Конкурирующее заявление о значении атрибута с провенансом; атрибут хранится как множество claims, а не как единое каноническое значение",
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "description": "JSON scalar value of the claim"
        },
        "source_node_guid": {
          "type": "string",
          "format": "uuid",
          "description": "Узел, заявивший значение"
        },
        "asserted_by_person_guid": {
          "type": "string",
          "format": "uuid",
          "description": "Эксперт, заявивший значение (scoped by source_node_guid)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Уверенность заявления 0..1"
        },
        "status": {
          "enum": [
            "candidate",
            "canonical",
            "rejected"
          ],
          "description": "candidate — заявлено, не разрешено; canonical — после N≥2 независимых подтверждений; rejected — отклонено"
        }
      },
      "required": [
        "value",
        "source_node_guid",
        "created_at"
      ],
      "additionalProperties": false
    }
  }
}